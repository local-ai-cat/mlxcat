.DS_Store
.build/
.swiftpm/
*.xcodeproj
DerivedData/
Package.resolved
# test model + generated artifacts (fixtures are committed; models are not)
Tests/MLXCatTests/Models/
*.safetensors
!Tests/MLXCatTests/Fixtures/*.safetensors

# Reference/donor engine clones (omlx, mlx-lm, vllm, ollama, ...) — never committed
guest/
bench/results/.logs/
__pycache__/

# Queue run state is per-machine; the passes themselves are committed.
bench/queue/**/*.done
bench/queue/**/*.failed
bench/queue/**/*.log
bench/queue/**/.lock/
bench/queue/**/.launchd.log

bench/queue/**/*.skipped
